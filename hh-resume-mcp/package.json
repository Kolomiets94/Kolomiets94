{
  "name": "hh-resume-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mcp": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "playwright": "npx -y @playwright/mcp@latest",
    "smoke:sources": "node scripts/smoke-sources.mjs",
    "smoke:store": "tsx scripts/smoke-store.ts",
    "check:local": "npm run typecheck && npm run smoke:store && npm run smoke:sources"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
